# LINE Developers > LIFF app ID
VITE_LIFF_ID=

# Supabase Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ใช้ true เพื่อบังคับโหมดทดลอง แม้มีคีย์แล้ว
VITE_DEMO_MODE=false

# รหัสผ่านผู้ดูแลสำหรับจัดการเลเยอร์/หมุดในหน้า ตั้งค่า
# ห้ามใส่รหัสผ่านตรง ๆ ให้ใส่ค่า SHA-256 hash (ตัวพิมพ์เล็ก) เช่น
# node -e "console.log(require('crypto').createHash('sha256').update('รหัสผ่านของคุณ').digest('hex'))"
# ถ้าไม่ตั้งค่านี้ หน้าเข้าสู่ระบบผู้ดูแลจะทำงานเป็นโหมดทดลอง (ผ่านได้ทันทีเพื่อทดสอบ)
VITE_ADMIN_PASSWORD_HASH=
